<Project>
	<PropertyGroup>
		<Version>1.0.9-alpha</Version>
		<AssemblyVersion>1.0.9.0</AssemblyVersion>
		<FileVersion>1.0.9.0</FileVersion>

		<Authors>www.botech.dev</Authors>
		<Copyright>All Rights Reserved!</Copyright>
		<PackageProjectUrl>https://www.botech.dev</PackageProjectUrl>
		<RepositoryUrl>https://github.com/BoTech-Development/BoTech.ApiClient.Base/</RepositoryUrl>
		<PackageIcon>.\BoTechLogoSmall.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>License.md</PackageLicenseFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)License.md" Pack="true" PackagePath="" Link="License.md" />
	</ItemGroup>
</Project>