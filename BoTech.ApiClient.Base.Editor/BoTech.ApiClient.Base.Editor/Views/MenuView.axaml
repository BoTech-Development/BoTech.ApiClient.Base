<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoTech.ApiClient.Base.Editor.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:ursa="https://irihi.tech/ursa"
             x:Class="BoTech.ApiClient.Base.Editor.Views.MenuView"
             x:DataType="vm:MenuViewModel">
    <Grid ColumnDefinitions="*, *"
          Margin="8,8,8,5">
        <Border Grid.Column="0" 
                CornerRadius="14"
                HorizontalAlignment="Left"
                Padding="4"
                BorderThickness="2"
                BorderBrush="#FFCECECE">
            <Menu>
                <MenuItem Header="File">
                    <MenuItem Header="New Project"
                              Command="{Binding OpenCreateNewProjectDialogCommand}"/>
                    <MenuItem Header="Open Project"
                              Command="{Binding OpenProjectDialogCommand}"/>
                    <MenuItem Header="Close"/>
                </MenuItem>
                <MenuItem Header="Export">
                    <MenuItem Header="Export BoTech.ApiClient.Base config json." 
                              Command="{Binding ExportApiClientBaseConfigJson}"/>
                    <MenuItem Header="build Api Client Project"/>
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="Open GitHub Page" 
                              Command="{Binding ShowGithubPageCommand}"/>
                    <MenuItem Header="Check for updates." 
                              Command="{Binding CheckForUpdatesCommand}"/>
                    <MenuItem Header="About" 
                              Command="{Binding ShowAboutDialogCommand}"/>
                </MenuItem>
            </Menu>
        </Border>
        <ursa:Badge Grid.Column="1"
                    Header="{Binding LatestVersion}"
                    HorizontalAlignment="Right"
                    IsVisible="{Binding IsUpdateAvailable}"
                    Margin="0,0,40,0">
            <Button Command="{Binding ExecuteUpdateCommand}">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon Kind="DownloadBoxOutline"
                                        IconSize="24"/>
                    <TextBlock Text="Update available!"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ursa:Badge>
    </Grid>
</UserControl>
