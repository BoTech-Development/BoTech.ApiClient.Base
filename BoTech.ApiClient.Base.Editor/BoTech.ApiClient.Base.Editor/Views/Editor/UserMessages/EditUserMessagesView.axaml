<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shadUi="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:vm="clr-namespace:BoTech.ApiClient.Base.Editor.ViewModels.Editor.UserMessages"
             x:Class="BoTech.ApiClient.Base.Editor.Views.Editor.UserMessages.EditUserMessagesView"
             x:DataType="vm:EditUserMessagesViewModel">
  <StackPanel Orientation="Horizontal">
      <StackPanel>
          <TextBlock Text="Possible Results for..."
                     FontSize="22"
                     FontWeight="Bold"/>
          <ListBox ItemsSource="{Binding PossibleResults}"
                   SelectedItem="{Binding SelectedPossibleResult}">
              <ListBox.ItemTemplate>
                  <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding DtoNameOrReturnTypeName}"
                                     VerticalAlignment="Center"
                                     FontSize="16"
                                     Margin="0,0,4,0"/>
                          <Border BorderBrush="{Binding ServerResultIndicatorBorderBrush}"
                                  Background="{Binding ServerResultIndicatorBackgroundBrush}"
                                  BorderThickness="2"
                                  CornerRadius="8"
                                  Padding="2">
                              <TextBlock Text="{Binding ServerResultStatusCode}" 
                                         FontWeight="SemiBold"/>
                          </Border>
                      </StackPanel>
                  </DataTemplate>
              </ListBox.ItemTemplate>
          </ListBox>
      </StackPanel>
      <Separator Height="NaN" 
                 Margin="5,0,5,0"
                 CornerRadius="2"
                 BorderThickness="4"/>
      <StackPanel>
          <TextBlock Text="User Message:"
                     FontSize="22"
                     FontWeight="Bold"/>
          <ComboBox shadUi:ControlAssist.Label="Your language:"
                    ItemsSource="{Binding CultureNamesIncludingLanguageName}"
                    SelectedIndex="{Binding SelectedSourceCultureIndex}"/>
          <TextBox Classes="Clearable"
                   UseFloatingPlaceholder="True"
                   PlaceholderText="Natural language description of the result."
                   shadUi:ControlAssist.Label="User Message:"
                   Margin="0,10,0,0"
                   Text="{Binding CurrentUserMessage}"/>
          <StackPanel Orientation="Horizontal">
              <Button Classes="Primary" 
                      Content="Translate"
                      Command="{Binding TranslateCurrentUserMessageCommand}"
                      Margin="0,10,0,0"/>
              <Button Classes="Secondary"
                      Content="Save Messages"
                      Command="{Binding SaveCurrentUserMessageForHttpResultCommand}"
                      Margin="10,10,0,0"/>
          </StackPanel>

          <TextBlock Text="Auto translations:"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Margin="0,10,0,0"/>
          <ListBox ItemsSource="{Binding AutoTranslatedUserMessages}"
                   Height="400">
              <ListBox.ItemTemplate>
                  <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                          <Border BorderBrush="Gray"
                                  Background="LightGray"
                                  BorderThickness="2"
                                  CornerRadius="8"
                                  Margin="0,0,4,0"
                                  Padding="1">
                              <TextBlock Text="{Binding Language.DisplayName}"
                                         FontWeight="SemiBold"/>
                          </Border>
                          <TextBlock Text="{Binding TranslatedMessage}"/>
                      </StackPanel>
                  </DataTemplate>
              </ListBox.ItemTemplate>
          </ListBox>
      </StackPanel>
  </StackPanel>
</UserControl>
