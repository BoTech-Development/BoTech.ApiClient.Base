<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:BoTech.ApiClient.Base.Editor.ViewModels.Editor.ControllerNav"
             x:Class="BoTech.ApiClient.Base.Editor.Views.Editor.ControllerNavPanelView"
             x:DataType="vm:ControllerNavPanelViewModel">
    <Design.DataContext>
        <vm:ControllerNavPanelViewModel/>
    </Design.DataContext>
    <Border CornerRadius="14"
            Padding="4"
            BorderThickness="2"
            BorderBrush="#FFCECECE">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Your Controllers"
                           FontWeight="Bold"
                           FontSize="18"
                           VerticalAlignment="Center"/>
                <Button>
                    <icons:MaterialIcon Kind="DotsVertical"/>
                </Button>
            </StackPanel>
            <TreeView ItemsSource="{Binding UserDefinedControllers}"
                      CornerRadius="14"
                      Padding="4"
                      BorderThickness="2"
                      BorderBrush="#FFCECECE"
                      SelectedItem="{Binding SelectedEndpointOrController}">
                <TreeView.DataTemplates>
                    <!-- Template for TypeA -->
                    <TreeDataTemplate DataType="vm:ControllerNavItemViewModel"
                                      ItemsSource="{Binding EndpointsDefinedInController}">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Kind="RhombusSplit"
                                                IconSize="24"/>
                            <TextBlock Text="{Binding ControllerName}"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                    </TreeDataTemplate>
                    <!-- Template for TypeB -->
                    <DataTemplate DataType="vm:EndpointItemViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,*">
                            <icons:MaterialIcon Grid.Column="0"
                                                Kind="RhombusMedium"
                                                IconSize="24"/>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding EndpointName}" 
                                           FontSize="14"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding Route}"
                                           FontSize="12"/>
                            </StackPanel>
                            <Border Grid.Column="2" 
                                    BorderBrush="{Binding HttpMethodIndicatorBorderColor}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Background="{Binding HttpMethodIndicatorBackgroundColor}"
                                    Padding="2"
                                    HorizontalAlignment="Right">
                                <TextBlock Text="{Binding HttpMethodName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TreeView.DataTemplates>
            </TreeView>
        </StackPanel>
    </Border>
</UserControl>
