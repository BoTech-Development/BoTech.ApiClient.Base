<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ursa="https://irihi.tech/ursa"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:BoTech.ApiClient.Base.Editor.ViewModels.Dialogs"
             x:Class="BoTech.ApiClient.Base.Editor.Views.Dialogs.CreateNewProjectDialogView"
             x:DataType="vm:CreateNewProjectDialogViewModel">
    <StackPanel Margin="15">
        <StackPanel Orientation="Horizontal">
            <icons:MaterialIcon Kind="PlusNetworkOutline" IconSize="32"/>
            <TextBlock Text="Create a new Project." FontWeight="Bold" FontSize="26"/>
        </StackPanel>

        <ursa:Descriptions Margin="0,10,0,0">
            <ursa:DescriptionsItem Label="Project Name:"
                                   LabelPosition="Top">
                <TextBox UseFloatingPlaceholder="True"
                         PlaceholderText="NewApiClientProject"
                         Text="{Binding ProjectName}"/>
            </ursa:DescriptionsItem>
            <ursa:DescriptionsItem Label="Project output path:"
                                   LabelPosition="Top">
                <TextBox UseFloatingPlaceholder="True"
                         PlaceholderText="Path to any folder"
                         Text="{Binding ProjectLocation}">
                    <TextBox.InnerRightContent>
                        <Button Command="{Binding OpenProjectLocationFileSelectorCommand}">
                            <icons:MaterialIcon Kind="Folder"/>
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
            </ursa:DescriptionsItem>
            <ursa:DescriptionsItem Label="Open Api .json File:"
                                   LabelPosition="Top">
                <TextBox UseFloatingPlaceholder="True"
                         PlaceholderText="Path to e.g. swagger.json"
                         Text="{Binding OpenApiDefinitionJsonFilePath}">
                    <TextBox.InnerRightContent>
                        <Button Command="{Binding OpenOpenApiFileSelectorCommand}">
                            <icons:MaterialIcon Kind="FileCode"/>
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
            </ursa:DescriptionsItem>
        </ursa:Descriptions>
        <TextBlock Text="Optional" 
                   FontSize="19" 
                   FontWeight="SemiBold"
                   Margin="0,10,0,0"/>
        <ursa:Descriptions Margin="0,10,0,0">
            <ursa:DescriptionsItem Label="Shared models (dtos) project-file:"
                                   LabelPosition="Top">
                <TextBox UseFloatingPlaceholder="True"
                         PlaceholderText="Path to dto .csproj"
                         Text="{Binding SharedModelProjectFile}">
                    <TextBox.InnerRightContent>
                        <Button Command="{Binding OpenSharedModelsProjectFileSelectorCommand}">
                            <icons:MaterialIcon Kind="FileCode"/>
                        </Button>
                    </TextBox.InnerRightContent>
                </TextBox>
            </ursa:DescriptionsItem>
        </ursa:Descriptions>
        <Button Margin="0,10,0,0"
                Command="{Binding CreateProjectCommand}"
                Classes="Primary"
                Theme="{DynamicResource SolidButton}">
            Create
        </Button>
  </StackPanel>
</UserControl>
