<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BoTech.ApiClient.Base.Editor.ViewModels.Editor.Main"
             xmlns:shadUi="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="BoTech.ApiClient.Base.Editor.Views.Editor.Main.MainTabPanelView"
             x:DataType="vm:MainTabPanelViewModel">
    <Design.DataContext>
        <vm:MainTabPanelViewModel/>
    </Design.DataContext>
    <TabControl ItemsSource="{Binding Tabs}">
      <TabControl.ItemTemplate>
          <DataTemplate DataType="vm:MainTabPanelViewModel+TabPage">
              <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Header}" 
                             VerticalAlignment="Center"/>
                  <Button Classes="Icon"
                          Command="{Binding $parent[UserControl].DataContext.CloseSpecificTabCommand}"
                          CommandParameter="{Binding}">
                      <shadUi:ButtonAssist.Icon>
                          <material:MaterialIcon Kind="Close"/>
                      </shadUi:ButtonAssist.Icon>
                  </Button>
              </StackPanel>


          </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
          <DataTemplate DataType="vm:MainTabPanelViewModel+TabPage">
              <ContentControl Content="{Binding Content}" />
          </DataTemplate>
      </TabControl.ContentTemplate>
  </TabControl>
</UserControl>
